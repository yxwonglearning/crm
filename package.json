    "test:smoke:workflow-repository": "node tests/smoke/workflow-repository-smoke.js",
    "test:smoke:workflow-configuration": "node tests/smoke/workflow-configuration-smoke.js",
    "test:smoke:workflow-approvers": "node tests/smoke/workflow-approvers-smoke.js",
    "test:smoke:workflow-conditions": "node tests/smoke/workflow-conditions-smoke.js",
    "test:smoke:workflow-attachments": "node tests/smoke/workflow-attachments-smoke.js",
